rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidSavedItem(data) {
      return data.keys().hasAll(['userId', 'ticker', 'mode', 'result', 'createdAt'])
        && data.keys().size() >= 5 && data.keys().size() <= 6
        && data.userId == request.auth.uid
        && data.ticker is string && data.ticker.size() <= 50
        && data.mode is string && data.mode.matches('^[A-Z_]{1,30}$')
        && data.result is string && data.result.size() <= 1048576
        && (!('title' in data) || (data.title is string && data.title.size() <= 120))
        && data.createdAt is timestamp;
    }

    match /users/{userId}/savedItems/{itemId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      
      allow create: if isSignedIn() 
                    && isValidId(userId)
                    && isValidId(itemId)
                    && request.auth.uid == userId
                    && request.auth.token.email_verified == true
                    && isValidSavedItem(incoming())
                    && incoming().createdAt == request.time;
                    
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
